{
  "uid": "face-detector-local-overview",
  "title": "Face Detector Local Overview",
  "tags": ["face-detector", "local", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend Request Rate",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(face_detector_http_requests_total{namespace=\"local\", service=\"backend\"}[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Backend 5xx Rate",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(face_detector_http_requests_total{namespace=\"local\", service=\"backend\", status_code=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Backend P95 Latency",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(face_detector_http_request_duration_seconds_bucket{namespace=\"local\", service=\"backend\"}[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dependency Health",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "min(face_detector_dependency_health_status{namespace=\"local\", service=\"backend\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Requests By Status",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(face_detector_http_requests_total{namespace=\"local\", service=\"backend\"}[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP Latency Buckets",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(face_detector_http_request_duration_seconds_bucket{namespace=\"local\", service=\"backend\"}[5m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Dependency Health By Dependency",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "face_detector_dependency_health_status{namespace=\"local\", service=\"backend\"}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests In Progress",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "face_detector_http_requests_in_progress{namespace=\"local\", service=\"backend\"}"
        }
      ]
    }
  ]
}
